{
  "name": "@jsisques/dotagent",
  "version": "0.0.0",
  "description": "Portable, configurable AI agent setup (skills, MCPs, etc.) installable via npx.",
  "type": "module",
  "bin": {
    "dotagent-cli": "./dist/main.js"
  },
  "files": [
    "dist",
    "catalog",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepare": "husky || true",
    "test:changed": "vitest run --changed origin/main --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
